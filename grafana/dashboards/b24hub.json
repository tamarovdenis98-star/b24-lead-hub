          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Заявки по статусу (по времени приёма)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "b24hub-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "b24hub-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(received_at, '2m'), status AS metric, count(*) AS value\nFROM inbox WHERE $__timeFilter(received_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Вызовы Битрикс24 в минуту",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "b24hub-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "b24hub-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(called_at, '1m'),\n       count(*) FILTER (WHERE ok) AS \"ok\",\n       count(*) FILTER (WHERE NOT ok AND retryable) AS \"retryable\",\n       count(*) FILTER (WHERE NOT ok AND NOT retryable) AS \"error\"\nFROM b24_call_log WHERE $__timeFilter(called_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "description": "Глобальный троттлинг: не больше 2 запросов в секунду (120 в минуту)"
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Время до CRM, с (p50 / p95 за 10 мин)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "b24hub-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "b24hub-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(i.received_at, '10m'),\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM a.crm_created_at - i.received_at)) AS \"p50\",\n       percentile_cont(0.95) WITHIN GROUP (ORDER BY extract(epoch FROM a.crm_created_at - i.received_at)) AS \"p95\"\nFROM assignments a JOIN inbox i ON i.id = a.inbox_id\nWHERE a.crm_created_at IS NOT NULL AND $__timeFilter(i.received_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Длительность вызова Б24, мс (p95 за минуту)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "b24hub-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "b24hub-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(called_at, '1m'),\n       percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms) AS \"p95\", avg(duration_ms) AS \"avg\"\nFROM b24_call_log WHERE $__timeFilter(called_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 11,
      "type": "barchart",
      "title": "Сделок по менеджерам",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "b24hub-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "b24hub-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 'менеджер ' || manager_id AS \"менеджер\", count(*) AS \"сделок\",\n       count(*) FILTER (WHERE reason LIKE 'existing client%') AS \"свой клиент\"\nFROM assignments WHERE $__timeFilter(assigned_at) GROUP BY manager_id ORDER BY manager_id"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Последние ошибки",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "b24hub-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "b24hub-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT occurred_at AS \"когда\", workflow_name AS \"workflow\", node_name AS \"нода\", left(error_message, 160) AS \"сообщение\", execution_url AS \"execution\"\nFROM errors WHERE $__timeFilter(occurred_at) ORDER BY id DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "type": "table",
      "title": "Робот «Проверить контрагента по ИНН»",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "b24hub-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "b24hub-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT at AS \"когда\", document_id AS \"документ\", inn AS \"ИНН\", result->>'CHECK_RESULT' AS \"результат\",\n       result->>'COMPANY_NAME' AS \"организация\", event_sent AS \"ответ в БП\"\nFROM robot_runs WHERE $__timeFilter(at) ORDER BY id DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
