  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Заявок принято",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "b24hub-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "b24hub-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"заявок\" FROM inbox WHERE $__timeFilter(received_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Обработано",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "b24hub-pg"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "b24hub-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE status IN ('done','rejected')) / nullif(count(*), 0), 1) AS \"обработано, %\"\nFROM inbox WHERE $__timeFilter(received_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "description": "done + rejected / принятые; rejected = непригодные контакты, не ретраятся"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "До CRM, p95",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "b24hub-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "b24hub-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT percentile_cont(0.95) WITHIN GROUP (ORDER BY extract(epoch FROM a.crm_created_at - i.received_at)) AS \"p95, с\"\nFROM assignments a JOIN inbox i ON i.id = a.inbox_id WHERE a.crm_created_at IS NOT NULL AND $__timeFilter(i.received_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "description": "от приёма заявки до сделки + задачи + SLA-элемента в Битрикс24"
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Упёрлись в лимит Б24",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "b24hub-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "b24hub-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"QUERY_LIMIT / OPERATION_TIME\" FROM b24_call_log\nWHERE error_code IN ('QUERY_LIMIT_EXCEEDED','OPERATION_TIME_LIMIT') AND $__timeFilter(called_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "SLA",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "b24hub-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "b24hub-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE sla_status = 'met') AS \"в срок\",\n       count(*) FILTER (WHERE sla_status = 'breached') AS \"нарушен\",\n       count(*) FILTER (WHERE sla_status = 'open' AND sla_due < now()) AS \"просрочено сейчас\"\nFROM assignments WHERE $__timeFilter(assigned_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Ошибок",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "b24hub-pg"
      },
      "gridPos": {
        "x": 21,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "b24hub-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"ошибок\" FROM errors WHERE $__timeFilter(occurred_at)"
        }
      ],
      "fieldConfig": {
