  "name": "[B24HUB] 05a robot inn check",
  "nodes": [
    {
      "id": "2e48fb07-34d8-5171-b0a7-4df88a7ccad2",
      "name": "Build result",
      "parameters": {
        "jsCode": "// Same item shape from all three paths: invalid INN, cache hit, fresh DaData.\nconst r = $json.r ?? $json;\nlet rv;\nif (!r.inn_valid) rv = { CHECK_RESULT: 'invalid_inn', IS_ACTIVE: 'N' };\nelse if (r.dadata_error) rv = { CHECK_RESULT: 'dadata_unavailable', IS_ACTIVE: 'N' };\nelse if (!r.cached?.found) rv = { CHECK_RESULT: 'not_found', IS_ACTIVE: 'N' };\nelse {\n  const d = r.cached.data;\n  rv = { CHECK_RESULT: d.status === 'ACTIVE' ? 'active' : String(d.status ?? 'unknown').toLowerCase(), COMPANY_NAME: d.name,\n         STATUS: d.status, IS_ACTIVE: d.status === 'ACTIVE' ? 'Y' : 'N', KPP: d.kpp, OGRN: d.ogrn, ADDRESS: d.address };\n}\nconst log = `b24-lead-hub: ИНН ${r.inn} → ${rv.CHECK_RESULT}${rv.COMPANY_NAME ? ' (' + rv.COMPANY_NAME + ')' : ''}`;\nreturn [{ json: { method: 'bizproc.event.send', auth: 'app', caller_workflow: $workflow.name, caller_execution_id: $execution.id,\n                  params: { EVENT_TOKEN: r.event_token, RETURN_VALUES: rv, LOG_MESSAGE: log },\n                  run: { document_id: r.document_id, inn: r.inn, result: rv } } }];\n"
      },
      "position": [
        2640,
        200
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "5b1f9189-6e65-51fc-a761-4a50c2ae3433",
      "name": "Cached?",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "20a8c4ba-884f-5602-b4ce-de9f4fbe040c",
              "leftValue": "={{ !!$json.r.cached }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          }
        },
        "options": {}
      },
      "position": [
        1760,
        120
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2
    },
    {
      "id": "f174d5de-81c7-5c5c-a0a7-1f3ce29802b7",
      "name": "Check INN",
      "parameters": {
        "jsCode": "function innValid(inn) {\n  const s = String(inn ?? '').trim();\n  if (!/^(\\d{10}|\\d{12})$/.test(s)) return false;\n  const d = s.split('').map(Number);\n  const chk = (w) => (w.reduce((acc, k, i) => acc + k * d[i], 0) % 11) % 10;\n  if (s.length === 10) return chk([2, 4, 10, 3, 5, 9, 4, 6, 8]) === d[9];\n  return chk([7, 2, 4, 10, 3, 5, 9, 4, 6, 8]) === d[10] && chk([3, 7, 2, 4, 10, 3, 5, 9, 4, 6, 8]) === d[11];\n}\n\nconst r = $json.r;\nreturn [{ json: { ...r, inn_valid: innValid(r.inn) } }];\n"
      },
      "position": [
        1100,
        200
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "671c2779-9f90-5c9c-baa2-0893cbb8d591",
      "name": "Check sent",
      "parameters": {
        "jsCode": "const r = $('b24: event.send').first().json;\nif (!r.ok) throw new Error(`bizproc.event.send failed: ${r.error_code} ${r.error_description ?? ''}`);\nreturn [{ json: { ok: true } }];\n"
      },
      "position": [
        3300,
        200
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
