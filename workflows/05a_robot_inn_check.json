      "id": "98710a73-179e-5a0d-b22b-0d002a224cc3",
      "name": "Journal",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ [$('Build result').first().json.run.document_id ?? '', $('Build result').first().json.run.inn, JSON.stringify($('Build result').first().json.run.result), $json.ok === true, $execution.id] }}"
        },
        "query": "WITH run AS (\n  INSERT INTO robot_runs (document_id, inn, result, event_sent, execution_id) VALUES ($1, $2, $3::jsonb, $4, $5) RETURNING id\n), ev AS (\n  INSERT INTO lead_events (inbox_id, deal_id, step, detail, execution_id)\n  SELECT a.inbox_id, a.deal_id, 'robot_inn_check',\n         jsonb_build_object('inn', $2, 'check_result', $3::jsonb->>'CHECK_RESULT', 'company_name', $3::jsonb->>'COMPANY_NAME', 'event_sent', $4), $5\n    FROM assignments a WHERE 'DEAL_' || a.deal_id = $1\n  RETURNING 1\n) SELECT (SELECT id FROM run) AS run_id, (SELECT count(*) FROM ev) AS lead_events"
      },
      "position": [
        3080,
        200
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "id": "57161899-8997-5c04-8918-42de77218e57",
      "name": "Parse",
      "parameters": {
        "jsCode": "// Robot handler POST (form-urlencoded): event_token, document_id[], properties[INN], auth[application_token], auth[member_id].\nconst b = $json.body ?? {};\nconst g = (nested, flat) => nested ?? b[flat] ?? null;\nconst doc = Array.isArray(b.document_id) ? b.document_id[2] : (b.document_id?.[2] ?? b['document_id[2]'] ?? null);\nreturn [{ json: { event_token: b.event_token ?? null, inn: String(g(b.properties?.INN, 'properties[INN]') ?? '').trim(),\n                  document_id: doc, token: g(b.auth?.application_token, 'auth[application_token]'),\n                  member_id: g(b.auth?.member_id, 'auth[member_id]') } }];\n"
      },
      "position": [
        220,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "73bf27de-94b7-52b0-a6e9-7e3b10035824",
      "name": "Parse DaData",
      "parameters": {
        "jsCode": "const r = $('DaData cache').first().json.r;\nconst status = Number($json.statusCode ?? 0);\nif (status !== 200) return [{ json: { ...r, dadata_error: `HTTP ${status}`, store: false } }];\nconst sug = ($json.body?.suggestions ?? [])[0], d = sug?.data;\nconst data = d ? { name: sug.value, full_name: d.name?.full_with_opf ?? null, type: d.type ?? null, kpp: d.kpp ?? null,\n  ogrn: d.ogrn ?? null, status: d.state?.status ?? null, region: d.address?.data?.region ?? null,\n  region_with_type: d.address?.data?.region_with_type ?? null, address: d.address?.value ?? null, okved: d.okved ?? null } : {};\nreturn [{ json: { ...r, cached: { found: !!d, data }, store: true } }];\n"
      },
      "position": [
        2200,
        40
      ],
      "type": "n8n-nodes-base.code",
