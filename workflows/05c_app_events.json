  "name": "[B24HUB] 05c app events",
  "nodes": [
    {
      "id": "5ccd2965-7d26-546b-996f-e44fc742fee8",
      "name": "App event",
      "parameters": {
        "httpMethod": "POST",
        "options": {},
        "path": "b24hub/app/events",
        "responseMode": "responseNode"
      },
      "position": [
        0,
