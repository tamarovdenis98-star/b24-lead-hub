      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ [JSON.stringify({ event: $json.event, deal_id: $json.deal_id, domain: $json.domain }), $json.token ?? ''] }}"
        },
        "query": "SELECT $1::jsonb || jsonb_build_object(\n  'valid', coalesce((SELECT outbound_token IS NOT NULL AND outbound_token = $2 FROM b24_auth WHERE id = 1), false)) AS ev"
      },
