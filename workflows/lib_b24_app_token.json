  "name": "[B24HUB] lib b24_app_token",
  "nodes": [
    {
      "id": "f5ef71d7-47a0-506a-8955-f27bcb3fc4f3",
      "name": "Action",
      "parameters": {
        "options": {
          "fallbackOutput": "extra"
        },
        "rules": {
          "values": [
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "id": "c3c29493-dd35-52d1-a78a-7cd184608d7f",
                    "leftValue": "={{ $json.action }}",
