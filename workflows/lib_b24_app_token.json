              },
              "outputKey": "refresh",
              "renameOutput": true
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "id": "0ebd6493-876d-5b68-9b48-4c75f8f93197",
                    "leftValue": "={{ $json.action }}",
                    "operator": {
                      "operation": "equals",
                      "type": "string"
                    },
                    "rightValue": "wait"
                  }
                ],
                "options": {
