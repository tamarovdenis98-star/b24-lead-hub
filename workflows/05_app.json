      "name": "Parse",
      "parameters": {
        "jsCode": "// Placement / app page: POST AUTH_ID, member_id, PLACEMENT, PLACEMENT_OPTIONS (JSON string); DOMAIN in the query.\nconst b = $json.body ?? {}, q = $json.query ?? {};\nlet opts = {};\ntry { opts = typeof b.PLACEMENT_OPTIONS === 'string' ? JSON.parse(b.PLACEMENT_OPTIONS) : (b.PLACEMENT_OPTIONS ?? {}); } catch { opts = {}; }\nreturn [{ json: { auth_id: b.AUTH_ID ?? null, member_id: b.member_id ?? null, domain: String(q.DOMAIN ?? b.DOMAIN ?? '').toLowerCase(),\n                  placement: b.PLACEMENT ?? null, deal_id: Number(opts.ID) || null } }];\n"
      },
      "position": [
        220,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "8ad35edf-b0d3-5d6e-a477-1a02c99bd92b",
      "name": "Render",
      "parameters": {
        "jsCode": "const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\n\nconst s = $json.s;\nconst k = (t, v) => `<span class=\"kpi\">${esc(t)}<b>${esc(v)}</b></span>`;\nconst errs = s.last_errors.map((e) => `<tr><td class=\"muted\">${esc(new Date(e.occurred_at).toLocaleString('ru-RU', { timeZone: 'Europe/Moscow' }))}</td><td>${esc(e.workflow_name)}</td><td>${esc(e.node_name)}</td><td>${esc(e.message)}</td></tr>`).join('') || '<tr><td colspan=\"4\" class=\"muted\">нет</td></tr>';\nconst html = `<!doctype html><html><head><meta charset=\"utf-8\"><title>b24-lead-hub</title><style>body{font:14px/1.45 -apple-system,Segoe UI,Roboto,sans-serif;color:#1f2933;margin:16px;background:#fff}h1{font-size:18px;margin:0 0 4px}h2{font-size:15px;margin:20px 0 8px}.muted{color:#6b7785}table{border-collapse:collapse;width:100%}td,th{border-bottom:1px solid #e6e9ee;padding:6px 8px;text-align:left;vertical-align:top}th{font-weight:600;color:#52606d;font-size:12px;text-transform:uppercase;letter-spacing:.03em}.b{display:inline-block;padding:2px 8px;border-radius:10px;font-size:12px;font-weight:600}.ok{background:#e3f6ea;color:#16794c}.bad{background:#fde8e8;color:#b42318}.wait{background:#fff4e0;color:#a15c00}.kpi{display:inline-block;margin:0 24px 8px 0}.kpi b{display:block;font-size:22px}code{font-size:12px}</style></head><body>\n<h1>b24-lead-hub</h1><p class=\"muted\">Приём заявок, дедупликация, назначение и контроль SLA</p>\n<div>${k('Заявок за 24 ч', s.leads_24h)}${k('Обработано', s.by_status.done ?? 0)}${k('Отклонено', s.by_status.rejected ?? 0)}${k('В ошибке', s.by_status.failed ?? 0)}</div>\n<div>${k('SLA в срок', s.sla.met ?? 0)}${k('SLA нарушен', s.sla.breached ?? 0)}${k('Ожидают ответа', s.sla.open ?? 0)}${k('Просрочено сейчас', s.open_overdue)}</div>\n<div>${k('Вызовов Б24 за час', s.b24_calls_1h)}${k('Упёрлись в лимит, 24 ч', s.limit_hits_24h)}${k('Проверок ИНН роботом, 24 ч', s.robot_runs_24h)}${k('Ошибок, 24 ч', s.errors_24h)}</div>\n<h2>Последние ошибки</h2><table><tr><th>Когда</th><th>Workflow</th><th>Нода</th><th>Сообщение</th></tr>${errs}</table></body></html>`;\nreturn [{ json: { html } }];\n"
      },
