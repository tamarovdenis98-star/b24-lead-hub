      "id": "9fb08e21-b02e-5abf-ab99-7a011e205166",
      "name": "Summary",
      "parameters": {
        "operation": "executeQuery",
        "options": {},
        "query": "SELECT json_build_object(\n  'leads_24h', (SELECT count(*) FROM inbox WHERE received_at > now() - interval '24 hours'),\n  'by_status', (SELECT coalesce(json_object_agg(status, n), '{}') FROM (SELECT status, count(*) n FROM inbox GROUP BY 1) x),\n  'sla', (SELECT coalesce(json_object_agg(sla_status, n), '{}') FROM (SELECT sla_status, count(*) n FROM assignments GROUP BY 1) x),\n  'open_overdue', (SELECT count(*) FROM assignments WHERE sla_status = 'open' AND sla_due < now()),\n  'errors_24h', (SELECT count(*) FROM errors WHERE occurred_at > now() - interval '24 hours'),\n  'b24_calls_1h', (SELECT count(*) FROM b24_call_log WHERE called_at > now() - interval '1 hour'),\n  'limit_hits_24h', (SELECT count(*) FROM b24_call_log WHERE called_at > now() - interval '24 hours' AND error_code IN ('QUERY_LIMIT_EXCEEDED','OPERATION_TIME_LIMIT')),\n  'robot_runs_24h', (SELECT count(*) FROM robot_runs WHERE at > now() - interval '24 hours'),\n  'last_errors', (SELECT coalesce(json_agg(e), '[]') FROM (SELECT occurred_at, workflow_name, node_name, left(error_message, 160) AS message FROM errors ORDER BY id DESC LIMIT 5) e)\n) AS s"
      },
