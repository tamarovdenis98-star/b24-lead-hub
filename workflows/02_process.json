      },
      "id": "c6b961ad-dea2-59d0-b9d9-47ad49b2b9ce",
      "name": "Claim batch",
      "parameters": {
        "operation": "executeQuery",
        "options": {},
        "query": "WITH cfg AS (\n  SELECT coalesce((SELECT value::int FROM settings WHERE key = 'process_batch_size'), 10)  AS batch,\n         coalesce((SELECT value::int FROM settings WHERE key = 'process_max_attempts'), 5) AS max_att,\n         -- bounded concurrency: in-flight leads (claimed, not finished) never exceed process_max_in_flight\n         greatest(0, coalesce((SELECT value::int FROM settings WHERE key = 'process_max_in_flight'), 20)\n                     - (SELECT count(*) FROM inbox WHERE status = 'processing' AND locked_at > now() - interval '10 minutes')) AS room\n), picked AS (\n  SELECT i.id\n    FROM inbox i, cfg\n   WHERE ((i.status IN ('new', 'failed') AND i.next_attempt_at <= now())\n          OR (i.status = 'processing' AND i.locked_at < now() - interval '10 minutes'))  -- crashed worker\n     AND i.attempt_count < cfg.max_att\n   ORDER BY i.next_attempt_at, i.id\n   LIMIT (SELECT least(batch, room) FROM cfg)\n   FOR UPDATE OF i SKIP LOCKED\n)\nUPDATE inbox i\n   SET status = 'processing', locked_at = now(), attempt_count = i.attempt_count + 1, updated_at = now()\n  FROM picked\n WHERE i.id = picked.id\nRETURNING i.id AS inbox_id, i.idempotency_key, i.source, i.payload, i.attempt_count, i.received_at"
      },
      "position": [
        220,
        300
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
