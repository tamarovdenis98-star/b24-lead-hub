      "id": "7827b49b-c31b-5b23-8baa-633b74aebbfa",
      "name": "Mark failed",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ [$('Claim batch').item.json.inbox_id, String($json.error?.message ?? $json.error ?? 'unknown error')] }}"
        },
        "query": "WITH rel AS (\n  DELETE FROM client_locks WHERE inbox_id = $1\n), u AS (\n  UPDATE inbox\n     SET status = 'failed', last_error = left($2, 2000), locked_at = NULL, updated_at = now(),\n         next_attempt_at = now() + make_interval(mins => power(2, attempt_count - 1)::int)\n   WHERE id = $1\n  RETURNING id, attempt_count, next_attempt_at\n)\nINSERT INTO lead_events (inbox_id, step, detail)\nSELECT id, 'failed', jsonb_build_object('attempt', attempt_count, 'error', left($2, 500), 'next_attempt_at', next_attempt_at) FROM u\nRETURNING inbox_id"
      },
