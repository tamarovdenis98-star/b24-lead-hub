# Copy to .env and fill in. Never commit .env.
# --- Postgres ---
POSTGRES_DB=b24hub
POSTGRES_USER=b24hub_owner
POSTGRES_PASSWORD=change-me-owner
# Role used by n8n (DML only, no DDL)
APP_DB_USER=b24hub_app
APP_DB_PASSWORD=change-me-app
# Host port for local access (bound to 127.0.0.1 only)
POSTGRES_HOST_PORT=55432

# --- Bitrix24 (stored in Postgres table b24_auth by scripts/seed_config.sh, never in workflows) ---
B24_WEBHOOK=https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/

# --- n8n (used by scripts/n8n_sync.py and replay scripts, not by containers) ---
N8N_URL=https://n8n.example.com/
N8N_API_KEY=
INTAKE_URL=https://n8n.example.com/webhook/b24hub/intake
INTAKE_SECRET=change-me-intake-shared-secret

# --- Alerts ---
TG_CHAT_ID=123456789
